{
  "name": "simpleworship",
  "private": true,
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @simpleworship/desktop tauri dev",
    "build": "pnpm --filter @simpleworship/desktop tauri build",
    "gen:bindings": "node scripts/gen-bindings.mjs",
    "check": "pnpm -r check",
    "test": "cargo test --workspace && pnpm -r test",
    "lint": "biome check . && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "biome format --write . && cargo fmt --all",
    "set-version": "node scripts/set-version.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
