    <div type="book" osisID="Gen">
      <chapter osisID="Gen.1">
        <title type="section">The Creation</title>
        <p>
          <verse sID="Gen.1.1" osisID="Gen.1.1"/>In the <w lemma="strong:H7225">beginning</w> God created the heavens and the earth.<note type="study">A footnote that must not appear.</note><verse eID="Gen.1.1"/>
          <verse sID="Gen.1.2" osisID="Gen.1.2"/>The earth was formless<lb/>and empty.<verse eID="Gen.1.2"/>
          <verse osisID="Gen.1.3">God said, “Let there be light,” and there was light.</verse>
        </p>
      </chapter>
    </div>
    <div type="book" osisID="John">
      <chapter osisID="John.3">
        <verse osisID="John.3.16">For God so loved the world &amp; gave his Son.</verse>
      </chapter>
