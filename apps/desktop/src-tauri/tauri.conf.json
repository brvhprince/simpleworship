{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleWorship",
  "identifier": "org.simpleworship.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SimpleWorship",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/media/**", "$APPDATA/thumbnails/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Free, open-source worship presentation software.",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../resources/bibles/eng-kjv2006_usfm.zip": "bibles/eng-kjv2006_usfm.zip",
      "../../../resources/bibles/engwebp_usfm.zip": "bibles/engwebp_usfm.zip"
    },
    "publisher": "SimpleWorship contributors",
    "copyright": "\u00a9 SimpleWorship contributors. GPL-3.0-or-later.",
    "homepage": "https://github.com/brvhprince/simpleworship",
    "fileAssociations": [
      {
        "ext": ["sws"],
        "name": "SimpleWorship Schedule",
        "description": "SimpleWorship schedule",
        "role": "Editor",
        "mimeType": "application/x-simpleworship-schedule"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["gstreamer1-plugins-good", "gstreamer1-plugins-bad-free", "gstreamer1-libav"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNTk4MDU2QjYxMkM5MEIKUldRTHlSSzJWb0JaNGZheWJSRVNFOGE5aHdtVWdsQ1N0TUlJcGJ3MHZ1Z1cxS1pnb0llYjBmNnEK",
      "endpoints": [
        "https://github.com/brvhprince/simpleworship/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
